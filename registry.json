        {
          "path": "registry/videocn/playback-rate-menu.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/playback-rate-menu.tsx"
        },
        {
          "path": "registry/videocn/picture-in-picture-toggle.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/picture-in-picture-toggle.tsx"
        },
        {
          "path": "registry/videocn/fullscreen-toggle.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/fullscreen-toggle.tsx"
        }
      ],
      "cssVars": {
        "light": {
          "player-scrim": "oklch(0 0 0 / 60%)"
        },
        "dark": {
          "player-scrim": "oklch(0 0 0 / 70%)"
        }
