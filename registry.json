{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "videocn",
  "homepage": "https://videocn.dev",
  "items": [
    {
      "name": "player",
      "type": "registry:ui",
      "title": "Video Player",
      "description": "Le lecteur vidéo complet : socle, contrôles, chapitres et sous-titres.",
      "registryDependencies": [
        "@shadcn/button",
        "@shadcn/slider"
      ],
      "dependencies": [
        "cn",
        "lucide-react"
      ],
      "files": [
        {
          "path": "registry/videocn/player-engine.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/player-engine.ts"
        },
        {
          "path": "registry/videocn/native-engine.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/native-engine.ts"
        },
        {
          "path": "registry/videocn/resolve-engine.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/resolve-engine.ts"
        },
        {
          "path": "registry/videocn/player-store.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/player-store.ts"
        },
        {
          "path": "registry/videocn/use-player.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/use-player.ts"
        },
        {
          "path": "registry/videocn/player-context.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/player-context.tsx"
        },
        {
          "path": "registry/videocn/controls-options.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/controls-options.ts"
        },
        {
          "path": "registry/videocn/controls-context.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/controls-context.tsx"
        },
        {
          "path": "registry/videocn/use-controls-visibility.ts",
          "type": "registry:ui",
          "target": "@ui/video-player/use-controls-visibility.ts"
        },
        {
          "path": "registry/videocn/video-cn.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/video-cn.tsx"
        },
        {
          "path": "registry/videocn/player-controls.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/player-controls.tsx"
        },
        {
          "path": "registry/videocn/player-menu.tsx",
          "type": "registry:ui",
          "target": "@ui/video-player/player-menu.tsx"
